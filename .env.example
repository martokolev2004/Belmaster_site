# PostgreSQL
DATABASE_URL="postgresql://belmaster:belmaster@localhost:5432/belmaster?schema=public"

# Публичен адрес на сайта
APP_URL="http://localhost:3000"
# Адрес на игровия сървър за браузъра. Празно = през сайта (/socket.io), препоръчително.
NEXT_PUBLIC_GAME_URL=""
# Къде сайтът намира игровия сървър отвътре (в Docker: http://game:4000)
GAME_INTERNAL_URL="http://localhost:4000"

# Таен ключ за токените между сайта и игровия сървър (дълъг случаен низ)
GAME_JWT_SECRET="change-me-to-a-long-random-string"

# Имейл на администратора
ADMIN_EMAIL="m.kolev@bulinfo.org"

# Google вход (по желание; без тях бутонът не се показва)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Имейли (потвърждение, забравена парола, съгласие на родител).
# Без SMTP_HOST имейлите не се пращат — записват се в Админ → Имейли.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM="БЕЛ Мастър <noreply@belmaster.eu>"
# Имейл за въпроси относно личните данни (показва се в Политиката)
PRIVACY_EMAIL="privacy@belmaster.eu"

# Потвърждение на сайта в Google Search Console и Bing Webmaster Tools (по желание)
